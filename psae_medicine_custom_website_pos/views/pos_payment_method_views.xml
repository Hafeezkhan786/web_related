<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.view.form.inherit.psae.medicine.custom.website.pos</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="split_transactions" position="before">
                <field name="has_surcharge"/>  
                <field name="surcharge_percent" class="w-25" widget="percentage" invisible="not has_surcharge" required="has_surcharge"/>
                <field name="surcharge_product_id" invisible="not has_surcharge" required="has_surcharge"/>
            </field>
        </field>
    </record>
</odoo>     
