<templates id="template" xml:space="preserve">
    <t t-name="psae_medicine_custom_website_pos.PaymentScreenDue" t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        <PriceFormatter position="attributes">
            <attribute name="price">currentOrder.formattedDisplayTotalDue</attribute>
        </PriceFormatter>
        <PriceFormatter position="after">
            <span t-if="currentOrder.totalSurcharge and !currentOrder.isRefund">
                <span class="ms-3 fs-6">incl.</span>
                <span class="ms-1 fs-3">
                    <PriceFormatter price="currentOrder.formattedTotalSurcharge"/>
                </span>
                <span class="ms-1 fs-6 text-muted">Surcharge</span>
            </span>
        </PriceFormatter>
    </t>
    <t t-name="psae_medicine_custom_website_pos.PaymentScreenMethods" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-method-display')]" position="attributes">
            <attribute name="t-att-class">{ 'w-100': paymentMethod.has_surcharge }</attribute>
        </xpath>
        <xpath expr="//span[hasclass('payment-name')]" position="after">
            <t t-if="paymentMethod.has_surcharge and !currentOrder.isRefund">
                <span name="surcharge-info" class="ms-auto align-self-center">
                    <button t-out="getFormattedSurchargeAmount(paymentMethod)" class="btn btn-lg bg-transparent text-truncate mx-1 min-w-4" disabled="1" />
                </span>
            </t>
        </xpath>
    </t>
</templates>
