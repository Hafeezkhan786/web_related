<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.block.negative.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']/.." position="after">
                <field name="is_negative_pos_allowed" string="Allow Negative POS" groups="point_of_sale.group_pos_manager"
                    invisible="not is_storable or not available_in_pos" />
            </xpath>

            <!-- <group name="pos" position="after">
                <group string="Negative Quantities Restriction">
                </group>
            </group> -->
        </field>
    </record>
</odoo>
