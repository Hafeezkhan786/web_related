<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Purchase Order Form View to add Free Qty Today & Vendor Price columns -->
    <record id="purchase_order_form_inherit_psae_custom" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.psae.custom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="after">
<!--                <field name="free_qty_today" readonly="1" optional="show"/>-->
                <field name="on_hand_qty_display" readonly="1" optional="show" string="On Hand Qty"/>
                <field name="min_max_qty_display" readonly="1" optional="show" string="Min / Max"/>
                 <field name="qty_delivered_current_month_display" readonly="1" optional="show" string="Curr Mnt Qty"/>
                <field name="qty_to_deliver_display" readonly="1" optional="show" string="Lst 2mnt Avg Sale"/>

            </xpath>
        </field>
    </record>

</odoo>
