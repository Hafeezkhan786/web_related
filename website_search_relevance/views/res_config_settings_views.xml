<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_search_relevance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.search.relevance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="after">
                <h2>Product Search &amp; Relevance</h2>
                <div class="row mt16 o_settings_container" id="search_relevance_settings">
                    <div class="col-12 col-lg-6 o_setting_box" id="prioritize_relevance_setting">
                        <div class="o_setting_left_pane">
                            <field name="search_prioritize_relevance"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="search_prioritize_relevance"/>
                            <div class="text-muted">
                                Show products whose names match the search keyword before description matches.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="exclude_descriptions_setting">
                        <div class="o_setting_left_pane">
                            <field name="search_exclude_descriptions"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="search_exclude_descriptions"/>
                            <div class="text-muted">
                                Restrict search to product names and codes only (ignores sales/e-commerce descriptions).
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
