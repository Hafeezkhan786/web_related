<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tree_view_inherit_list_custom_fields" model="ir.ui.view">
        <field name="name">product.template.product.list.inherit.custom.fields</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="uom_ids" widget="many2many_tags" optional="hide"/>
                <field name="alternative_product_ids" widget="many2many_tags" optional="hide"/>
                <field name="website_auto_add_product_ids" widget="many2many_tags" optional="hide"/>
                <field name="website_auto_add_pkg_qty" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
