<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">view.order.form.inherit.psae.payment.methods</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="payment_type_id" string="Online Payment Method" invisible="not payment_type_id"/>
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter" model="ir.ui.view">
        <field name="name">view.sales.order.filter.inherit.psae.payment.methods</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="preferred_payment_method_line_groupby" position="after">
                <filter name="group_payment_type" context="{'group_by':'payment_type_id'}"/>
            </filter>
        </field>
    </record>

    <record id="sale_order_tree" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.psae.payment.methods</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="date_order" position="after">
                <field name="payment_type_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
