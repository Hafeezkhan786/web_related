<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="registration_sequence" model="ir.sequence">
            <field name="name">WB Portal Time Off Sequence</field>
            <field name="code">wb_portal.leave.sequence</field>
            <field name="prefix">TS/%(day)s/%(month)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="loan_sequence" model="ir.sequence">
            <field name="name">WB Portal Loan Sequence</field>
            <field name="code">wb.loan.seq</field>
            <field name="prefix">LN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
