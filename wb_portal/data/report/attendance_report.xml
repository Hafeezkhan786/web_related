<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_attendance_portal" model="ir.actions.report">
        <field name="name">Attendance Report</field>
        <field name="model">hr.attendance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wb_portal.attendance_report_portal</field>
        <field name="report_file">wb_portal.attendance_report_portal</field>
        <field name="print_report_name">'Attendance - %s' % (object.employee_id.name)</field>
    </record>
</odoo>
