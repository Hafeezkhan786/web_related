<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="attendance_report_portal" name="Attendance Report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="o_report_header">
                        <h2>Attendance Report</h2>
                        <p class="o_report_meta">
                            Employee:
                            <span t-if="employee" t-esc="employee.name"/>
                            <span t-else="">&#8212;</span>
                            &#160;|&#160;
                            Period:
                            <span t-out="start_date.strftime('%d-%m-%Y')"/>
                            &#8212;
                            <span t-out="end_date.strftime('%d-%m-%Y')"/>
                        </p>
                    </div>

                    <table class="table table-sm o_report_table">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th>Employee Name</th>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th>Location</th>
                                <th class="text-end">Work Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="c_data" t-as="d">
                                <tr>
                                    <td class="text-center" t-esc="d_index + 1"/>
                                    <td t-esc="c_data[d]['emp']"/>
                                    <td>
                                        <span t-if="c_data[d]['checkin']"
                                              t-esc="c_data[d]['checkin'].strftime('%d-%m-%Y %H:%M')"/>
                                        <span t-else="">&#8212;</span>
                                    </td>
                                    <td>
                                        <span t-if="c_data[d]['checkout']"
                                              t-esc="c_data[d]['checkout'].strftime('%d-%m-%Y %H:%M')"/>
                                        <span t-else="">&#8212;</span>
                                    </td>
                                    <td>
                                        <span t-esc="c_data[d]['location'] or '—'"/>
                                        <span t-if="c_data[d]['geo_verified']">&#160;(verified)</span>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'{0:.2f}'.format(c_data[d]['workhours'])"/>
                                        hrs
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="o_report_total">
                                <td colspan="5" class="text-end">Total Hours</td>
                                <td class="text-end">
                                    <span t-esc="'{0:.2f}'.format(total_hours)"/>
                                    hrs
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
