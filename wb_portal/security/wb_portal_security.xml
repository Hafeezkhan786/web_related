<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Record rules for the models this module owns.

      Native modules (planning / event / hr_expense) keep their own access
      rules; the portal enforces "own records only" at the controller level
      (domains always filter by the session employee, detail views re-check
      ownership, creates force employee_id server-side).
    -->

    <!-- Employees may only see their own loans -->
    <record id="wb_loan_rule_employee" model="ir.rule">
        <field name="name">WB Loan: own records (employees)</field>
        <field name="model_id" ref="model_wb_loan"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- HR managers see all loans -->
    <record id="wb_loan_rule_manager" model="ir.rule">
        <field name="name">WB Loan: all records (HR managers)</field>
        <field name="model_id" ref="model_wb_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>
</odoo>
