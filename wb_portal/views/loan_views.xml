<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wb_loan_tree_view" model="ir.ui.view">
        <field name="name">wb.loan.tree</field>
        <field name="model">wb.loan</field>
        <field name="arch" type="xml">
            <list string="Employee Loans" sample="1">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="date"/>
                <field name="loan_type"/>
                <field name="amount" sum="1"/>
                <field name="installments"/>
                <field name="remaining_amount" string="Remaining"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('approved', 'paid')"
                       decoration-warning="state == 'submitted'"
                       decoration-danger="state in ('refused', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="wb_loan_form_view" model="ir.ui.view">
        <field name="name">wb.loan.form</field>
        <field name="model">wb.loan</field>
        <field name="arch" type="xml">
            <form string="Employee Loan">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state not in ('submitted', 'draft')"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state not in ('submitted', 'draft')"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            invisible="state not in ('approved',)"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('paid', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="loan_type"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="installments"/>
                            <field name="installment_amount" readonly="1"/>
                            <field name="paid_amount"/>
                            <field name="remaining_amount" readonly="1"/>
                        </group>
                    </group>
                    <group string="Approval">
                        <field name="approved_by" readonly="1"/>
                        <field name="approval_date" readonly="1"/>
                        <field name="refusal_reason" readonly="1"/>
                    </group>
                    <group string="Details">
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wb_loan_action" model="ir.actions.act_window">
        <field name="name">Employee Loans</field>
        <field name="res_model">wb.loan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first employee loan</p>
            <p>Loans applied through the HR portal appear here for review and approval.</p>
        </field>
    </record>

    <menuitem id="wb_loan_menu" name="Loans" parent="hr.menu_hr_main"
              action="wb_loan_action" sequence="60" groups="hr.group_hr_user"/>
</odoo>
