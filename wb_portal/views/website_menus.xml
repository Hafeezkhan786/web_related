    <record id="menu_hr_payslips" model="website.menu">
        <field name="name">Payslips</field>
        <field name="url">/payslip/</field>
        <field name="parent_id" ref="wb_portal.menu_hr_portal"/>
        <field name="sequence">30</field>
    </record>

    <record id="menu_hr_leaves" model="website.menu">
        <field name="name">Time Off</field>
        <field name="url">/leaveview/</field>
        <field name="parent_id" ref="wb_portal.menu_hr_portal"/>
