<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top level portal menu -->
    <record id="menu_hr_portal" model="website.menu">
        <field name="name">My HR Portal</field>
        <field name="url">/home/</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">20</field>
    </record>

    <record id="menu_hr_dashboard" model="website.menu">
        <field name="name">Dashboard</field>
        <field name="url">/home/</field>
        <field name="parent_id" ref="wb_portal.menu_hr_portal"/>
