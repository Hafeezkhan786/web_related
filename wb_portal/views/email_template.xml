<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_for_leave_request" model="mail.template">
        <field name="name">Leave Request Notification</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="subject">Leave Request from {{ object.employee_id.name or '' }}</field>
        <field name="email_from">{{ object.employee_id.work_email or '' }}</field>
        <field name="email_to">{{ object.employee_id.leave_manager_id.email or '' }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; color: #2d3436;">
                <div style="background: linear-gradient(135deg, #6c5ce7, #a29bfe); padding: 24px 32px; border-radius: 12px 12px 0 0;">
                    <h2 style="margin: 0; color: #ffffff;">Time Off Request</h2>
                </div>
                <div style="background: #ffffff; border: 1px solid #ececec; border-top: 0; padding: 24px 32px; border-radius: 0 0 12px 12px;">
                    <p>Hello <strong t-out="object.employee_id.leave_manager_id.name or 'Manager'"/>,</p>
                    <p><strong t-out="object.employee_id.name"/> has submitted a time off request:</p>
                    <table style="width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 14px;">
                        <tr>
                            <td style="padding: 8px 12px; background: #f4f5fb; width: 160px;"><strong>Leave Code</strong></td>
                            <td style="padding: 8px 12px;"><span t-out="object.sequence or '—'"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 12px; background: #f4f5fb;"><strong>Leave Type</strong></td>
                            <td style="padding: 8px 12px;"><span t-out="object.holiday_status_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 12px; background: #f4f5fb;"><strong>Leave From</strong></td>
                            <td style="padding: 8px 12px;"><span t-out="object.request_date_from"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 12px; background: #f4f5fb;"><strong>Leave To</strong></td>
                            <td style="padding: 8px 12px;"><span t-out="object.request_date_to"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 12px; background: #f4f5fb;"><strong>No of Days</strong></td>
                            <td style="padding: 8px 12px;"><span t-out="object.duration_display"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 12px; background: #f4f5fb;"><strong>Reason</strong></td>
                            <td style="padding: 8px 12px;"><span t-out="object.name"/></td>
                        </tr>
                    </table>
                    <p style="margin-top: 24px;">Please review this request in the <strong>Time Off</strong> application.</p>
                    <p style="margin-top: 32px; font-size: 12px; color: #7f8c9b;">This is an automated message from the HR portal.</p>
                </div>
            </div>
        </field>
    </record>
</odoo>
