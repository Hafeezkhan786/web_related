#: wb_portal
msgid "You"
msgstr "آپ"

#: wb_portal
msgid "You are not checked in yet today."
msgstr "آپ نے آج ابھی حاضری نہیں لگائی۔"

#: wb_portal
msgid "You have not submitted any time off request yet."
msgstr "آپ نے ابھی کوئی چھٹی کی درخواست جمع نہیں کی۔"

#: wb_portal
msgid "You're all caught up — no pending requests."
msgstr "آپ نے سب مکمل کر لیا ہے — کوئی زیر التوا درخواست نہیں۔"

#: wb_portal
msgid "Your application will be reviewed by HR."
msgstr "آپ کی درخواست کا جائزہ HR لیں گے۔"

#: wb_portal
msgid "Your time off request %s has passed the first approval."
msgstr "آپ کی چھٹی کی درخواست %s پہلی منظوری سے گزر گئی۔"

#: wb_portal
msgid "Your time off request %s was approved."
msgstr "آپ کی چھٹی کی درخواست %s منظور ہو گئی۔"

#: wb_portal
msgid "Your time off request %s was refused."
msgstr "آپ کی چھٹی کی درخواست %s مسترد ہو گئی۔"

#: wb_portal
msgid "Your user account is not linked to any employee record. Please contact your HR administrator."
msgstr "آپ کا اکاؤنٹ کسی ملازم کے ریکارڈ سے منسلک نہیں ہے۔ براہ کرم اپنے HR منتظم سے رابطہ کریں۔"

#: wb_portal
msgid "awaiting action"
msgstr "کارروائی کے منتظر"

#: wb_portal
msgid "days"
msgstr "دن"

#: wb_portal
msgid "half days"
msgstr "آدھے دن"

#: wb_portal
msgid "has submitted a time off request:"
msgstr "نے چھٹی کی درخواست جمع کی ہے:"

#: wb_portal
msgid "hours"
msgstr "گھنٹے"

#: wb_portal
msgid "just now"
msgstr "ابھی ابھی"

#: wb_portal
msgid "record(s)"
msgstr "ریکارڈ(ز)"

#: wb_portal
msgid "request(s)"
msgstr "درخواست(یں)"

#: wb_portal
msgid "seats left"
msgstr "نشستیں باقی"

#: wb_portal
msgid "ticket(s)"
msgstr "ٹکٹ(ز)"

#: wb_portal
msgid "upcoming"
msgstr "آنے والی"

#: wb_portal
msgid "work"
msgstr "کام"
