#. module: wb_portal
#: model:mail.template,body_html:wb_portal.email_template_for_leave_request
msgid ""
"<div style=\"margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; color: #2d3436;\">\n"
"                <div style=\"background: linear-gradient(135deg, #6c5ce7, #a29bfe); padding: 24px 32px; border-radius: 12px 12px 0 0;\">\n"
"                    <h2 style=\"margin: 0; color: #ffffff;\">Time Off Request</h2>\n"
"                </div>\n"
"                <div style=\"background: #ffffff; border: 1px solid #ececec; border-top: 0; padding: 24px 32px; border-radius: 0 0 12px 12px;\">\n"
"                    <p>Hello <strong t-out=\"object.employee_id.leave_manager_id.name or 'Manager'\"/>,</p>\n"
"                    <p><strong t-out=\"object.employee_id.name\"/> has submitted a time off request:</p>\n"
"                    <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 14px;\">\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb; width: 160px;\"><strong>Leave Code</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.sequence or '—'\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb;\"><strong>Leave Type</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.holiday_status_id.name\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb;\"><strong>Leave From</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.request_date_from\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb;\"><strong>Leave To</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.request_date_to\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb;\"><strong>No of Days</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.duration_display\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb;\"><strong>Reason</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.name\"/></td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <p style=\"margin-top: 24px;\">Please review this request in the <strong>Time Off</strong> application.</p>\n"
"                    <p style=\"margin-top: 32px; font-size: 12px; color: #7f8c9b;\">This is an automated message from the HR portal.</p>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; color: #2d3436;\">\n"
"                <div style=\"background: linear-gradient(135deg, #6c5ce7, #a29bfe); padding: 24px 32px; border-radius: 12px 12px 0 0;\">\n"
"                    <h2 style=\"margin: 0; color: #ffffff;\">طلب إجازة</h2>\n"
"                </div>\n"
"                <div style=\"background: #ffffff; border: 1px solid #ececec; border-top: 0; padding: 24px 32px; border-radius: 0 0 12px 12px;\">\n"
"                    <p>مرحباً <strong t-out=\"object.employee_id.leave_manager_id.name or 'المدير'\"/>,</p>\n"
"                    <p><strong t-out=\"object.employee_id.name\"/> قدم طلب إجازة:</p>\n"
"                    <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 14px;\">\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb; width: 160px;\"><strong>رمز الإجازة</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.sequence or '—'\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb;\"><strong>نوع الإجازة</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.holiday_status_id.name\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb;\"><strong>إجازة من</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.request_date_from\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb;\"><strong>إجازة إلى</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.request_date_to\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb;\"><strong>عدد الأيام</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.duration_display\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 8px 12px; background: #f4f5fb;\"><strong>السبب</strong></td>\n"
"                            <td style=\"padding: 8px 12px;\"><span t-out=\"object.name\"/></td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <p style=\"margin-top: 24px;\">يرجى مراجعة هذا الطلب في تطبيق <strong>الإجازات</strong>.</p>\n"
"                    <p style=\"margin-top: 32px; font-size: 12px; color: #7f8c9b;\">هذه رسالة آلية من بوابة الموارد البشرية.</p>\n"
"                </div>\n"
"            </div>\n"
"        "

