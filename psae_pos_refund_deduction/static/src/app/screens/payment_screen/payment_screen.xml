<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="psae_pos_refund_deduction.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <div t-if="isRefundOrder" class="d-flex flex-row gap-1 w-100">
                <button class="button btn btn-lg w-100 lh-lg d-flex justify-content-between align-items-center"
                    t-att-class="{ 'btn-primary active': isDeductionApplied, 'btn-secondary': !isDeductionApplied }"
                    t-on-click="toggleDeduction">
                    <span class="d-flex align-items-center gap-2">
                        <i class="fa fa-percent" />
                        <span>-2% Deduction</span>
                    </span>
                    <i class="fa" t-att-class="{ 'fa-check-square': isDeductionApplied, 'fa-square-o': !isDeductionApplied }" />
                </button>
            </div>
        </xpath>
    </t>
</templates>
