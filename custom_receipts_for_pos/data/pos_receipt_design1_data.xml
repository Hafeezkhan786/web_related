<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Examples for receipt design: which can be used or modified -->
    <record id="pos_receipt_design1" model="pos.receipt">
        <field name="name">Design 1</field>
        <field name="design_receipt"><![CDATA[

        <div class="pos-receipt">
            <t t-if="env.services.pos.config.logo">
                <img t-att-src="'data:image/png;base64,' + env.services.pos.config.logo"
                     alt="Logo" class="pos-receipt-logo"/>
                <br />
             </t>
            <div class="pos-receipt-contact">
                <t t-if="env.services.pos.company.name">
                    <div><t t-esc="env.services.pos.company.name" /></div>
                </t>
                <t t-if="env.services.pos.company.phone">
                    <div>Tel:<t t-esc="env.services.pos.company.phone" /></div>
                </t>
                <div>Whatsapp #0334-6399-879</div>
                <div>Whatsapp #0321-0477-759</div>
                <div>UAN # 0333-722-2221</div>
                <div>STRN# 3277876341689</div>
                <div>NTN# 9352512-0</div>
                <t t-if="env.services.pos.company.vat">
                    <div><t t-esc="env.services.pos.company.vat_label"/>:<t t-esc="env.services.pos.company.vat" /></div>
                </t>
                <t t-if="env.services.pos.company.email">
                    <div><t t-esc="env.services.pos.company.email" /></div>
                </t>
                <t t-if="env.services.pos.company.website">
                    <div><t t-esc="env.services.pos.company.website" /></div>
                </t>
                <t t-if="props.receipt.headerData and props.receipt.headerData.header">
                    <t t-out="props.receipt.headerData.header" />
                </t>
                <t t-if="props.receipt.headerData and props.receipt.headerData.cashier">
                    <div class="cashier">
                        <div>--------------------------------</div>
                        <div>Served by <t t-esc="props.receipt.headerData.cashier" /></div>
                    </div>
                </t>
            </div>
            <br/>
            <t t-if="props.receipt.headerData and props.receipt.headerData.header">
                <div style='text-align:center; font-size:13px'>
                    <t t-esc="props.receipt.headerData.header" />
                </div>
                <br />
            </t>
            <div>
                <table class='receipt-orderlines' style="font-size:15px; border-style:double;
                  border-left:none; border-right:none; border-bottom:none; width:100%;">
                    <colgroup>
                        <col width='20%' />
                        <col width='50%' />
                        <col width='30%' />
                    </colgroup>
                    <tr style="border-bottom:1px dashed black;">
                        <th style="text-align:left;">Qty</th>
                        <th style="text-align:left;">Product</th>
                        <th style="text-align:right;">Amount</th>
                    </tr>
                    <t t-if="props.order and props.order.length and props.order and props.order.pos and props.order.pos.mainScreen and props.order.pos.mainScreen.props and props.order.pos.mainScreen.props.order and props.order.pos.mainScreen.props.order.orderlines and props.order.pos.mainScreen.props.order.orderlines.length">
                        <t t-if="props.order.pos.mainScreen.props">
                            <tr t-foreach="props.order.pos.mainScreen.props.order.orderlines" t-as="orderline" t-key="orderline.uuid">
                                <td style="padding-top:1%; padding-bottom:1%; text-align:left; font-size:14px; vertical-align:top;">
                                    <t t-esc="orderline.get_quantity_str_with_unit()"/>
                                </td>
                                <td style="padding-top:1%; padding-bottom:1%; text-align:left; vertical-align:top;">
                                    <div><t t-esc="orderline.productName"/></div>
                                    <div style="font-size:11px; color:#808080;">
                                        x

                                        <!-- DISCOUNT CONDITION START -->
                                        <t t-if="orderline.discountPercentage &gt; 0">
                                            <span style="text-decoration: line-through; margin-right: 4px;">
                                                <t t-esc="orderline.originalUnitPrice"/>
                                            </span>
                                            <t t-esc="orderline.unitPrice"/> <t t-esc="orderline.unit"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="orderline.unitPrice"/> <t t-esc="orderline.unit"/>
                                        </t>
                                        <!-- DISCOUNT CONDITION END -->

                                        <t t-if="orderline.packaging"> [<t t-esc="orderline.packaging"/>]</t>
                                    </div>
                                    <t t-if="orderline.customerNote">
                                        <div style="font-size:14px;" t-esc="orderline.customerNote"/>
                                    </t>
                                </td>
                                <td style="text-align:right; font-size:14px; padding-top:1%; padding-bottom:1%; vertical-align:top;">
                                    <t t-esc="env.utils.formatCurrency(orderline.get_display_price())"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-if="props.orderlines and props.orderlines.length">
                            <tr t-foreach="props.orderlines" t-as="orderline" t-key="orderline.uuid">
                                <td style="padding-top:1%; padding-bottom:1%; text-align:left; font-size:14px; vertical-align:top;">
                                    <t t-esc="orderline.qty"/>
                                </td>
                                <td style="padding-top:1%; padding-bottom:1%; text-align:left; vertical-align:top;">
                                    <div><t t-esc="orderline.productName"/></div>
                                    <div style="font-size:11px; color:#808080;">
                                        x

                                        <!-- DISCOUNT CONDITION START -->
                                        <t t-if="orderline.discountPercentage &gt; 0">
                                            <span style="text-decoration: line-through; margin-right: 4px;">
                                                <t t-esc="orderline.originalUnitPrice"/>
                                            </span>
                                            <t t-esc="orderline.unitPrice"/> <t t-esc="orderline.unit"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="orderline.unitPrice"/> <t t-esc="orderline.unit"/>
                                        </t>
                                        <!-- DISCOUNT CONDITION END -->

                                        <t t-if="orderline.packaging"> [<t t-esc="orderline.packaging"/>]</t>
                                    </div>
                                    <t t-if="orderline.customerNote">
                                        <div style="font-size:14px;" t-esc="orderline.customerNote"/>
                                    </t>
                                </td>
                                <td style="text-align:right; font-size:14px; padding-top:1%; padding-bottom:1%; vertical-align:top;">
                                    <t t-esc="orderline.price"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </table>
            </div>
            <br />
            <div style="padding-top:6px;">
                <t t-set='taxincluded' t-value='Math.abs(props.receipt.amount_total - props.receipt.total_with_tax) &lt;= 0.000001' />
                <t t-if='!taxincluded'>
                    <br/>
                    <div style="font-weight:700; font-size:14px; border-top:1px dashed;">
                        <span style="margin-left:40%;">Subtotal : </span>
                        <span t-esc='env.utils.formatCurrency(props.data.total_without_tax)'
                            class="pos-receipt-right-align"/>
                    </div>
                    <t t-foreach='props.data.tax_details' t-as='tax' t-key="tax.id">
                        <div style="font-weight:700; font-size:14px;">
                            <span style="margin-left:40%;"><t t-esc='tax.tax.name' /></span>
                            <span t-esc='env.utils.formatCurrency(tax.amount)'
                                    class="pos-receipt-right-align"/>
                        </div>
                    </t>
                </t>
                <!-- Total -->
                <br/>
                <div style="font-weight:700; font-size:14px;">
                    <span style="margin-left:40%;">TOTAL : </span>
                    <span t-esc='env.utils.formatCurrency(props.data.amount_total)' class="pos-receipt-right-align"/>
                </div>
                <br/><br/>
            </div>
            <div class='before-footer' />
            <br/><br/>
            <!-- Footer -->
            <div class="pos-receipt-order-data">
                <div><t t-esc="props.receipt.name" />
            </div>
            <t t-if="props.receipt.date">
                <div><t t-esc="props.receipt.date" /></div>
            </t>
            <t t-else="">
                <div><t t-esc="props.receipt.date" /></div>
            </t>
            </div>
            <br/><br/>
            <!-- ============================================ -->
            <!-- FBR INVOICE INFORMATION SECTION START        -->
            <!-- ============================================ -->
            <t t-if="props.data.fbr_invoice_number">
        <div style="margin-top: 20px; text-align: center; border-top: 2px solid #000;
                    border-bottom: 2px solid #000; padding: 15px 10px;">

            <!-- FBR Section Heading -->
            <div style="font-weight: bold; font-size: 16px; margin-bottom: 15px;
                        text-transform: uppercase; letter-spacing: 1px;">
                FBR INVOICE INFORMATION
            </div>

            <!-- FBR Logo -->
            <div style="text-align: center; margin-bottom: 10px;">
                <img t-if="props.data.has_fbr_logo"
                     t-attf-src="/web/image?model=res.company&amp;id={{props.data.fbr_company_id}}&amp;field=fbr_pos_logo"
                     style="width: 60px; height: auto;"
                     alt="FBR Logo"/>
                <img t-if="!props.data.has_fbr_logo"
                     src="/sng_pos_fbr_integration/static/img/fbr_logo.png"
                     style="width: 60px; height: auto;"
                     alt="Default FBR Logo"/>
            </div>

            <!-- Invoice Number -->
            <div style="text-align: center; margin-bottom: 5px;">
                <div style="font-size: 11px; color: #333; font-weight: 600; margin-bottom: 2px;">
                    INVOICE NO:
                </div>
                <div style="font-size: 14px; font-weight: bold; color: #000; letter-spacing: 0.5px;">
                    <t t-esc="props.data.fbr_invoice_number"/>
                </div>
            </div>

            <!-- Verified by FBR Badge -->
            <div style="text-align: center; margin-bottom: 10px;">
                <div style="font-size: 10px; color: #28a745; font-weight: 600;">
                    ✓ VERIFIED BY FBR
                </div>
            </div>

            <!-- QR Code for Verification -->
            <div style="text-align: center; margin-top: 10px;">
                <img t-attf-src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&amp;data={{props.data.fbr_invoice_number}}"
                     style="width: 70px; height: 70px; border: 1px solid #ccc; padding: 3px;"
                     alt="FBR QR Code"/>
                <div style="font-size: 9px; color: #666; margin-top: 5px; font-weight: 500;">
                    Scan to verify invoice
                </div>
            </div>
        </div>
    </t>

            <!-- FBR Status Section (shown only when status is NOT 'posted') -->
            <t t-if="props.data.fbr_status and props.data.fbr_status != 'posted'">
        <div style="margin-top: 15px; text-align: center;
                    border-top: 1px dashed #ccc; padding-top: 10px;">
            <div style="font-weight: bold; font-size: 14px; margin-bottom: 8px;">
                FBR STATUS
            </div>

            <!-- Failed Status -->
            <div t-if="props.data.fbr_status == 'failed'"
                 style="color: #dc3545; font-size: 12px;">
                ❌ FBR Posting Failed
                <div t-if="props.data.fbr_error_message"
                     style="font-size: 10px; margin-top: 4px;">
                    <t t-esc="props.data.fbr_error_message"/>
                </div>
            </div>

            <!-- Pending Status -->
            <div t-if="props.data.fbr_status == 'pending'"
                 style="color: #ffc107; font-size: 12px;">
                ⏳ Pending FBR Response
            </div>

            <!-- Draft Status -->
            <div t-if="props.data.fbr_status == 'draft'"
                 style="color: #6c757d; font-size: 12px;">
                📝 Not sent to FBR
            </div>
        </div>
    </t>
            <!-- ============================================ -->
            <!-- FBR INVOICE INFORMATION SECTION END          -->
            <!-- ============================================ -->

             <!-- ============================================ -->
<!--            &lt;!&ndash; TERMS AND CONDITIONS SECTION START           &ndash;&gt;-->
<!--            &lt;!&ndash; ============================================ &ndash;&gt;-->
<!--            <div style="margin-top: 15px; text-align: left; padding: 10px; font-size: 10px; border-top: 1px dashed #000;">-->
<!--                <div style="font-weight: bold; font-size: 11px; margin-bottom: 8px; text-align: center;">-->
<!--                    TERMS AND CONDITIONS-->
<!--                </div>-->
