<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_page_form_view_inherit_custom_seo_schema" model="ir.ui.view">
        <field name="name">website.page.form.view.inherit.custom.seo.schema</field>
        <field name="model">website.page</field>
        <field name="inherit_id" ref="website.website_pages_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="SEO Schema">
                    <field name="custom_seo_schema" placeholder='{"@context": "https://schema.org/", "@type": "WebPage", ...}' widget="ace" options="{'type': 'json'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
