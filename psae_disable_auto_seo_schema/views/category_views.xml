<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_public_category_form_view_inherit_custom_seo_schema" model="ir.ui.view">
        <field name="name">product.public.category.form.view.inherit.custom.seo.schema</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="SEO Schema">
                    <field name="custom_seo_schema" placeholder='{"@context": "https://schema.org/", "@type": "CollectionPage", ...}' widget="ace" options="{'type': 'json'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
